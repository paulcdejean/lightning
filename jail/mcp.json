{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10
  },
  "mcpServers": {
    "opentofu": {
      "url": "https://mcp.opentofu.org/mcp",
      "lifecycle": "lazy",
      "directTools": true
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "lifecycle": "lazy",
      "directTools": false
    }
  }
}
